// Copy to Secrets.xcconfig (gitignored) and fill in.
// Note: "//" starts a comment in xcconfig, so URLs use $(SLASH).
SLASH = /
SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY =
// Slí transit server (see server/README.md). Leave as-is for the simulator talking to a local server.
TRANSIT_API_URL = http:$(SLASH)$(SLASH)127.0.0.1:8000
